# Application
DEBUG=false
# Origin for CORS + full SPA OAuth callback URL for redirect_uri validation
CORS_ORIGINS=["http://localhost:5173","http://localhost:5173/auth/callback"]

# Database (Week 2)
DATABASE_URL=postgresql+asyncpg://knowledge_ai:knowledge_ai@localhost:5432/knowledge_ai

# Redis (Week 8)
REDIS_URL=redis://localhost:6379/0

# Voyage AI embeddings (Week 8)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
VOYAGE_EMBEDDING_DIMENSIONS=1024
# Drop weak semantic matches (cosine similarity floor). Override per request with ?min_similarity=
SEARCH_MIN_SIMILARITY=0.45

# Google OAuth (Week 3) — create Web client at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# MCP agent OAuth callback — register this URI in Google Console too (Week 12)
MCP_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/mcp/callback
MCP_ISSUER_URL=http://localhost:8000

# JWT (Week 3) — generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting (Week 22) — Redis fixed-window counters
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SEARCH_PER_WINDOW=30
RATE_LIMIT_AUTH_PER_WINDOW=20

# Sentry (Week 22) — leave empty to disable
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# Transactional email via Resend (Week 22) — leave key empty to skip sends
RESEND_API_KEY=
EMAIL_FROM=Knowledge-AI <onboarding@resend.dev>
APP_PUBLIC_URL=http://localhost:5173

# Application
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# Database (Week 2)
DATABASE_URL=postgresql+asyncpg://knowledge_ai:knowledge_ai@localhost:5432/knowledge_ai

# Redis (Week 8)
REDIS_URL=redis://localhost:6379/0

# Google OAuth (Week 3) — create Web client at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# JWT (Week 3) — generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API base (default uses Vite proxy → http://localhost:8000)
VITE_API_BASE_URL=/api/v1

# SPA origin used as OAuth redirect_uri (must match CORS_ORIGINS on the API)
VITE_SPA_ORIGIN=http://localhost:5173

# Optional — leave empty to disable Sentry in local dev
VITE_SENTRY_DSN=

# Source map upload (CI only) — used by @sentry/vite-plugin when building for production
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
